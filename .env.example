# Copia este archivo a .env.local y completa los valores.

# Vercel Blob — almacena los correos del gate/contacto.
# Crea un Blob store en Vercel → Settings → Blob y copia el token.
BLOB_READ_WRITE_TOKEN=

# (Opcional) Clave para leer los correos guardados vía GET /api/subscribe?key=...
ADMIN_KEY=

# (Opcional) Resend — además de guardarlos, te los envía por correo.
RESEND_API_KEY=
CONTACT_TO=fredolds180@gmail.com
